# ===== Jira Cloud =====
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-api-token-here
JIRA_PROJECT_KEY=PROJ

# ===== Jira Server / Data Center (use instead of email+token) =====
# JIRA_PAT=your-personal-access-token

# ===== Xray =====
# Platform: cloud | server
XRAY_PLATFORM=cloud
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret
# For Xray Server only:
# XRAY_SERVER_BASE_URL=https://your-jira-server.com

# ===== Google Sheets =====
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google_sheet/service-account.json
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
